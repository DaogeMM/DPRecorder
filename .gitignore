# ═══════════════════════════════════════════════════════════════════════════
#  repository/ —— DPRecorder 的代码 + 资源仓库
#
#  只收「代码 + 资源」。构建产物、依赖、缓存、示例谱面（example/，本机放在仓库
#  之外）一律不进仓库。DPS/.gitignore 与 DPR/.gitignore 仍在各自目录里生效，
#  这里是仓库级的补充。
#
#  本机在仓库上一级的 .cargo/config.toml 里用 [build] target-dir 把 target/ 钉到仓库
#  之外；下面这条 target/ 是给「在别处 clone、没有那份本机配置」的人兜底的。
# ═══════════════════════════════════════════════════════════════════════════

# ── 构建产物 ───────────────────────────────────────────────────────────────
target/

# ── 依赖 / 缓存 ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 前端构建输出 ───────────────────────────────────────────────────────────
dist/
dist-ssr/
coverage/

# ── Tauri 生成物（capabilities 的 schema，构建时由 tauri-build 重新生成）───
# 带 `**/` 前缀才会在任意深度生效（`gen/schemas/` 这种写法只匹配仓库根）。
**/gen/schemas/

# ── 本机 Cargo 配置（沙箱对策，本机专用、不随仓库分发）─────────────────────
.cargo/

# ── 日志 / 临时 ────────────────────────────────────────────────────────────
*.log
logs/

# ── 编辑器 / 系统 ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ── 静态库（体积大、可重建）────────────────────────────────────────────────
static-lib/
